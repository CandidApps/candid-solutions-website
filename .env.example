# Zoho Mail API (OAuth) — contact / partner forms
# Docs: https://www.zoho.com/mail/help/api/getting-started-with-api.html
#
# Sends FROM ZOHO_FROM_ADDRESS TO CONTACT_TO_EMAIL.
# For the connect@ group inbox, use a user who has Send As on that group
# (from = connect@…, to = connect@…).

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=connect@candid.solutions
CONTACT_TO_EMAIL=connect@candid.solutions

# Optional (defaults shown)
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_MAIL_API_URL=https://mail.zoho.com/api
