# Candid Solutions — legacy URL redirects (WordPress → Next.js)
# Place in site document root. Requires Apache mod_rewrite.
# Keep in sync with src/lib/redirects.ts and next.config.ts.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_HOST} ^www\.candid\.solutions$ [NC]
  RewriteRule ^ https://candid.solutions%{REQUEST_URI} [R=301,L]

  # Prefer HTTPS (uncomment if TLS terminates on this host)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Core IA ---
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^contact-us/?$ /contact [R=301,L]
  RewriteRule ^become-an-agent/?$ /agents [R=301,L]
  RewriteRule ^partner-program/?$ /agents [R=301,L]
  RewriteRule ^partners/?$ /agents [R=301,L]
  RewriteRule ^agent/?$ /agents [R=301,L]
  RewriteRule ^our-company/?$ /about [R=301,L]
  RewriteRule ^company/?$ /about [R=301,L]
  RewriteRule ^save/?$ /solutions [R=301,L]
  RewriteRule ^sitemap/?$ /sitemap.xml [R=301,L]

  # --- Legal ---
  RewriteRule ^about/privacy-policy/?$ /privacy [R=301,L]
  RewriteRule ^privacy-policy/?$ /privacy [R=301,L]
  RewriteRule ^about/terms-and-conditions/?$ /terms [R=301,L]
  RewriteRule ^terms-and-conditions/?$ /terms [R=301,L]

  # --- Legacy marketing ---
  RewriteRule ^sap-s4hana\.html$ /solutions/technology [R=301,L]
  RewriteRule ^sap-s4hana/?$ /solutions/technology [R=301,L]
  RewriteRule ^nproject/?$ /about [R=301,L]
  RewriteRule ^nproject/.*$ /about [R=301,L]
  RewriteRule ^business-machine-agents/?$ /agents [R=301,L]

  # --- Blog (no blog on rebuild) ---
  RewriteRule ^blog/?$ / [R=301,L]
  RewriteRule ^blog/.*$ / [R=301,L]

  # --- Old solution pages → Technology / products ---
  RewriteRule ^solutions/physical-security/?$ /solutions/technology [R=301,L]
  RewriteRule ^solutions/cyber-security/?$ /solutions/cybersecurity [R=301,L]
  RewriteRule ^solutions/customer-experience/?$ /solutions/contact-center [R=301,L]
  RewriteRule ^solutions/cloud-infrastructure/?$ /solutions/cloud [R=301,L]
  RewriteRule ^solutions/sd-wan/?$ /solutions/internet [R=301,L]
  RewriteRule ^solutions/internet-sd-wan/?$ /solutions/internet [R=301,L]
  RewriteRule ^solutions/managed-mobility/?$ /solutions/mobility [R=301,L]
  RewriteRule ^solutions/voip/?$ /solutions/contact-center [R=301,L]
  RewriteRule ^solutions/ucaas/?$ /solutions/contact-center [R=301,L]
  RewriteRule ^solutions/managed-services/?$ /solutions/technology [R=301,L]
  RewriteRule ^solutions/managed-it/?$ /solutions/technology [R=301,L]
  RewriteRule ^solutions/telecom-audits/?$ /solutions/candidiq [R=301,L]
  RewriteRule ^solutions/tem/?$ /solutions/candidiq [R=301,L]
  RewriteRule ^solutions/expense-management/?$ /solutions/candidiq [R=301,L]
  RewriteRule ^solutions/payments/?$ /solutions/payment-processing [R=301,L]
  RewriteRule ^solutions/industry-solutions/?$ /solutions [R=301,L]
  RewriteRule ^solutions/industry-solutions/commerce/?$ /solutions [R=301,L]
  RewriteRule ^solutions/industry-solutions/payments/?$ /solutions/candidpay [R=301,L]
  RewriteRule ^solutions/industry-solutions/commercial-real-estate/?$ /solutions [R=301,L]
</IfModule>
